{
  "name": "gsu",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "next dev",
    "local:ue": "ENV=ue.local next dev --experimental-https --experimental-https-key ./certs/key.pem --experimental-https-cert ./certs/certificate.pem",
    "dev:ue": "ENV=ue.dev next dev",
    "build": "next build",
    "start": "next start",
    "serve": "next build && next start -p 3400",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write .",
    "tag:release": "scripts/tag-release.sh",
    "test": "playwright test",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:unit:coverage": "vitest run --project unit --coverage",
    "postinstall": "node -e \"try{if(require('fs').existsSync('.git'))require('child_process').execFileSync(process.execPath,['node_modules/simple-git-hooks/simple-git-hooks.js'],{stdio:'inherit'})}catch(e){}\""
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && yarn test:unit",
    "pre-push": "trap 'docker image rm gs-vtk-backend:precheck 2>/dev/null || true' EXIT; docker build --build-arg ENV=dev -t gs-vtk-backend:precheck ."
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,scss,css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/credential-provider-node": "^3.972.30",
    "@bem-react/classname": "^1.6.0",
    "@opensearch-project/opensearch": "^3.5.1",
    "@react-pdf/renderer": "^4.5.1",
    "axios": "^1.15.0",
    "axios-cache-interceptor": "^1.12.0",
    "classnames": "^2.5.1",
    "dotenv": "^17.4.2",
    "i18next": "^25.1.2",
    "ioredis": "^5.11.1",
    "isomorphic-dompurify": "^3.13.0",
    "jose": "^6.2.3",
    "next": "16.2.3",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.9.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.5.1",
    "react-pdf-html": "^2.1.5",
    "sass": "^1.99.0",
    "sass-embedded": "^1.99.0",
    "sharp": "^0.33.5",
    "ts-md5": "^1.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@chromatic-com/storybook": "^5.1.2",
    "@dotenvx/dotenvx": "^0.45.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-onboarding": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/builder-vite": "^10.3.5",
    "@storybook/nextjs-vite": "^10.3.5",
    "@storybook/react": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/vimeo__player": "^2.18.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^3",
    "@vitest/coverage-v8": "^3",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.3.5",
    "lint-staged": "^15.2.10",
    "playwright": "^1.59.1",
    "prettier": "^3.5.3",
    "simple-git-hooks": "^2.11.1",
    "storybook": "^10.3.5",
    "typescript": "^5",
    "typescript-eslint": "^8.58.1",
    "vite-plugin-svgr": "^4.3.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3"
  },
  "sideEffects": false,
  "resolutions": {
    "**/picomatch": ">=2.3.2",
    "**/minimatch": "^9.0.6",
    "**/brace-expansion": "^2.0.2",
    "**/flatted": ">=3.4.0",
    "**/glob": ">=10.5.0",
    "**/svgo": ">=3.3.3",
    "**/form-data": ">=4.0.4",
    "**/lodash": ">=4.17.23",
    "**/js-yaml": ">=4.1.1",
    "**/handlebars": ">=4.7.9"
  }
}
