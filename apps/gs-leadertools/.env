### Application settings
DEBUG=false

### Search integration
SEARCH_TYPE=awsOpenSearch
# Secret token required in X-Reindex-Token header to trigger reindex (POST /api/search/reindex)
REINDEX_SECRET=

### PDF print self-fetch
# Base URL the container uses to fetch its own static assets (fonts, /img
# proxy) and warm-up requests. Must be reachable from inside the container —
# the public hostname is not, behind AWS hairpin NAT. Defaults to
# http://127.0.0.1:${PORT} (PORT=80 in production Docker, 3000 locally).
# Override only if Next.js binds somewhere other than loopback.
INTERNAL_BASE_URL=

### AWS General configuration
AWS_REGION=us-east-1
AWS_PROFILE=gs-vtk-runner

### AEM integration
NEXT_PUBLIC_AEM_API=https://prod.girlscouts.org/aem/

### AWS OpenSearch configuration
OPEN_SEARCH_ENDPOINT=https://twfp90mbdsps65ninsm4.us-east-1.aoss.amazonaws.com

### Image proxy
AEM_API=https://prod.girlscouts.org/aem/
AEM_DAM_PATH=content/dam/gsusa-vtk-redesign
NEXT_PUBLIC_AEM_DAM_PATH=content/dam/gsusa-vtk-redesign
